{
  "name": "@spinth/app",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "spinth board application shell",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.sw.json && vite build && vite build --config vite.sw.config.ts && node ../../scripts/check-debug-bundle.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@spinth/core": "workspace:*",
    "@spinth/react": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "fflate": "^0.8.3",
    "tailwindcss": "^4.1.13",
    "vite": "^7.1.9"
  }
}
