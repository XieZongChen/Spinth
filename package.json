{
  "name": "spinth-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "spinth — local-first whiteboard (mind map + canvas widgets)",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @spinth/app dev",
    "build": "pnpm --filter @spinth/app build",
    "preview": "pnpm --filter @spinth/app preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm lint && prettier --check . && pnpm typecheck && pnpm -r test && pnpm build",
    "test:e2e": "NO_PROXY=localhost,127.0.0.1 no_proxy=localhost,127.0.0.1 playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^5.0.0"
  }
}
